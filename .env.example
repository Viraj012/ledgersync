# Copy to .env (gitignored):  cp .env.example .env

# Secret used to verify Stripe webhook signatures.
# - Local demo / scripts/simulate.py: the value below works as-is.
# - Real Stripe test mode: replace with the whsec_... printed by
#     stripe listen --forward-to localhost:8080/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_local_demo_secret

# Optional: make the mock ERP flaky from startup (can also be changed live via PUT /mock-erp/config)
# ERP_MOCK_FAILURE_RATE=0.3
# ERP_MOCK_LATENCY_MS=0

# Optional DB overrides (defaults match docker-compose.yml)
# DB_URL=jdbc:postgresql://localhost:5432/ledgersync
# DB_USER=ledgersync
# DB_PASSWORD=ledgersync
